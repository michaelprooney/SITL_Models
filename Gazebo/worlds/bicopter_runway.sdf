    <include>
      <pose degrees="true">-29 545 0 0 0 363</pose>
      <uri>model://runway</uri>
    </include>

    <include>
      <pose degrees="true">0 0 0.03 0 0 90</pose>
      <uri>model://bicopter_with_ardupilot</uri>
    </include>

  </world>
